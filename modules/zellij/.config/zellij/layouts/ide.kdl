layout {
    tab name="NVIM" focus=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="nvim"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Lovely Assistant" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="copilot-project"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Terminal" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Docker" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
