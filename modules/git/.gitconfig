[include]
    path = ~/.config/git/local.inc

[user]
    useConfigOnly = true

[init]
    defaultBranch = main

[fetch]
    prune = true

[pull]
    ff = only

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[merge]
    conflictstyle = zdiff3

[core]
    excludesfile = ~/.config/git/ignore

[color]
    ui = auto

[tag]
    sort = version:refname

[branch]
    sort = -committerdate

[diff]
    algorithm = histogram

[alias]
    st = status -sb
    sw = switch
    co = checkout
    br = branch
    ci = commit
    last = log -1 --stat
    lg = log --graph --decorate --date=short --pretty=format:%C(auto)%h %C(blue)%ad%Creset %s %C(green)(%an)%Creset%d
