#!/usr/bin/env bash
set -euo pipefail

AGENT_CLI="${AGENT_CLI:-copilot}"

if ! command -v "$AGENT_CLI" >/dev/null 2>&1; then
    printf 'agent-project: %s CLI is not installed\n' "$AGENT_CLI" >&2
    exit 1
fi

project_root=""
if command -v git >/dev/null 2>&1; then
    project_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [[ -z "$project_root" ]]; then
    project_root="$PWD"
fi

cd "$project_root"
exec "$AGENT_CLI" "$@"
